{
    "id": "jitsi-meet",
    "uuid": "f055f2e5-227a-5fb4-b934-5397ec32cf2d",
    "name": "Jitsi Meet",
    "version": "1.4.68",
    "class": "extension",
    "coreApiVersion": "v1",
    "capabilities": ["meeting:video", "meeting:chat", "meeting:moderation"],
    "entrypoints": {
        "bootstrap": "./bootstrap.js",
        "api": "./api/index.js",
        "ui": "./ui/index.html",
        "cli": "./cli/index.js"
    },
    "publisher": "Cognis Labs HQ",
    "ui": {
        "stringsBaseUrl": "/static/modules/jitsi-meet/languages",
        "preferences": [
            {
                "key": "instanceUrl",
                "labelKey": "module.jitsi_meet.admin.config.instance_url",
                "descriptionKey": "module.jitsi_meet.admin.config.instance_url_description",
                "type": "string"
            },
            {
                "key": "meetingPrefix",
                "labelKey": "module.jitsi_meet.admin.config.meeting_prefix",
                "descriptionKey": "module.jitsi_meet.admin.config.meeting_prefix_description",
                "type": "string"
            }
        ]
    },
    "share": {
        "shareable": true,
        "mountScriptUrl": "/static/modules/jitsi-meet/share-mount.js",
        "stringsBaseUrl": "/static/modules/jitsi-meet/languages",
        "guestApiScopes": [
            "meeting:join",
            "participants:read",
            "chat:read",
            "chat:write"
        ]
    },
    "requires": [
        "e8732526-8976-54ef-828b-ed0dfe21bd9e",
        "4387fae9-26dd-5a80-84b2-e5f4833b7fb9",
        "0da92508-63fa-53ed-918c-e6f08692a382",
        "062a74f5-5699-52fb-98a3-63ec6538bdfc"
    ],
    "requiresCapabilities": ["auth:requireAuth", "ui:profileAvatarRenderer"],
    "summary": "Secure video meetings integrated with Cognis.",
    "description": "Create, join, moderate, and share Jitsi meetings from Cognis.",
    "categories": ["Collaboration"],
    "license": "AGPL-3.0-or-later",
    "repository": "https://github.com/Cognis-Labs-HQ/cognis-module-jitsi-meet",
    "assets": {
        "screenshots": [],
        "icon": "assets/icon.png",
        "banner": "assets/banner.png"
    },
    "tags": ["video", "meetings"],
    "homepage": "https://github.com/Cognis-Labs-HQ/cognis-module-jitsi-meet#readme",
